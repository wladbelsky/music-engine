{
  "name": "music-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Audio-reactive engine wallpaper for Wallpaper Engine (tests and CI tooling only; the wallpaper itself has no build step)",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --test-reporter=spec \"test/unit/*.test.js\" \"test/scene/*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 \"test/e2e/*.test.js\"",
    "baseline": "node tools/baseline.js",
    "sync:project": "node tools/sync-project.js",
    "preview": "node tools/preview.js",
    "vendor:three": "node tools/vendor-three.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "gifenc": "1.0.3",
    "playwright": "1.56.1",
    "three": "0.187.0"
  },
  "engines": {
    "node": ">=22"
  }
}
